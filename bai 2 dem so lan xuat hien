#include<iostream>
#include<vector>
using namespace std;
int main(){
	int n;
	cout<<"NHAP SO LUONG PHAN TU: ";
	cin>> n;
	vector<int> v(n);
	for(int i = 0; i < n; i++){
		cout<<"Nhap lan luot cac phan tu trong day: ";
		cin>> v[i];
	}
	int x;
	int dem = 0;
	cout<<"NHAP SO NGUYEN X CAN TIM: ";
	cin>> x;
	for(int i = 0; i < n; i++){
		if(x == v[i]){
			dem++;
		}
	}
	cout<<"SO LAN XUAT HIEN CUA : "<< x << "TRONG VECTOR LA: "<< dem << endl;
	return 0;
	
}
