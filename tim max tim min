#include<iostream>
#include<vector>
using namespace std;
int main(){
	int n;
	cout<<"Nhap so luong phan tu trong day: ";
	cin>> n;
	vector<int> v(n);
	
	for(int i = 0; i < n; i++){
		cout<<"Nhap lan luot cac phan tu trong day: ";
		cin>>v[i];
	}
	int min = v[0];
	int max = v[0];
	for(int i = 1; i < n; i++){
		if(min > v[i]){
			min = v[i];
		}
		if(max < v[i]){
			max = v[i];
	}
}
	cout<<"MIN cua day la "<< min << endl;
	cout<<"MAX cua day la "<< max << endl;
	return 0;
}
